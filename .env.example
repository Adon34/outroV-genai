# Database
DB_USER=postgres
DB_PASSWORD=${DB_PASSWORD:-postgres123}
DB_NAME=diet_chatbot
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD:-redis123}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ChromaDB
CHROMA_HOST=chroma-db
CHROMA_PORT=8000
CHROMA_URL=http://${CHROMA_HOST}:${CHROMA_PORT}

# JWT
JWT_SECRET=TMP6vfSXYvugXaKE6ix4TxxUDOTUK3dJjBiw3HQvV1A=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=OPENAI_API_KEY
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# API Keys (opcional)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
EXERCISE_API_KEY=

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Frontend
REACT_APP_API_URL=http://localhost/api
REACT_APP_WS_URL=ws://localhost/ws

# Monitoring
GRAFANA_PASSWORD=${GRAFANA_PASSWORD:-admin}


# Configurações para o orchestrator
AGENT_MAX_ITERATIONS = 3
AGENT_CONFIDENCE_THRESHOLD = 0.4
ENABLE_STREAMING = True
ENABLE_CHECKPOINTING = True

# Configurações de performance
BATCH_SIZE = 500
CACHE_TTL = 3600
MAX_CONCURRENT_REQUESTS = 10